# ============================================================
# Air2 — 外部依赖（submodule）
#
# 这些是编译必需的第三方库。用 submodule 而不是 vendored 源码，
# 理由与 Air1 一致：
#   · 保持上游可更新（git submodule update --remote）
#   · 不把第三方代码混进我们的提交历史
#   · 体积不占主仓库
#
# 与 Air1 的差异：
#   · 去掉了 ThirdParty/ZalithLauncher2 —— 那是 Air1 用来抄 ZL2
#     源码的，我们用不到
#   · Natives/external/MobileGlues 在 Air1 是 vendored 源码（不是
#     submodule），我们用同样方式
# ============================================================

[submodule "Natives/external/DBNumberedSlider"]
	path = Natives/external/DBNumberedSlider
	url = https://github.com/immago/DBNumberedSlider.git

[submodule "Natives/external/fishhook"]
	path = Natives/external/fishhook
	url = https://github.com/facebook/fishhook.git
	branch = main

[submodule "Natives/external/AFNetworking"]
	path = Natives/external/AFNetworking
	url = https://github.com/AFNetworking/AFNetworking

[submodule "Natives/external/ZeroTierFramework"]
	path = Natives/external/ZeroTierFramework
	url = https://github.com/zerotier/zerotier-sockets-apple-framework.git
