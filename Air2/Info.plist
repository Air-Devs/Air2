<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh-Hans</string>

    <key>CFBundleDisplayName</key>
    <string>Air2</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- ============================================================
         方向：锁定横屏
         Minecraft Java 版是横屏游戏，启动器横屏可避免启动瞬间
         的方向切换黑屏。同时也只声明横屏，系统层面就不会允许旋转。
         ============================================================ -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- 状态栏：横屏下隐藏，把空间还给内容 -->
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- 关闭启动画面（用我们自己的首帧） -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string></string>
    </dict>

    <!-- 外观：默认跟随系统 -->
    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>

    <!-- 支持的设备能力 -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- ============================================================
         Scene 配置。工程用代码方式配置 scene delegate
         （见 A2AppDelegate 的 configurationForConnectingSceneSession），
         这里声明支持多场景即可。
         ============================================================ -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- 文件共享：允许通过「文件」App 导入整合包与 mod -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- 相册访问：自定义背景选图 -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Air2 需要访问相册，以便你选择一张图片作为启动器背景。</string>

    <!-- 本地网络：之后的联机功能会用到 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Air2 需要访问本地网络，用于发现局域网内的 Minecraft 服务器。</string>

    <!-- 后台模式：游戏运行时的音频播放 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
